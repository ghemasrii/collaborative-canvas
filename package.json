{
  "name": "collaborative-canvas",
  "version": "1.0.0",
  "description": "Real-Time Collaborative Drawing Canvas application with multi-user sync and global undo/redo",
  "main": "dist/server/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json",
    "start": "node dist/server/server.js",
    "dev": "ts-node-dev --respawn --transpile-only server/server.ts"
  },
  "dependencies": {
    "express": "^4.19.2",
    "uuid": "^9.0.1",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.5"
  }
}
